# Google Gemini API Key(s) - supports 1 key or comma-separated multiple keys for rotation
GEMINI_API_KEY=your_gemini_api_key_here
# Optional extra keys (also supports comma-separated list)
# GEMINI_API_KEYS=key_1,key_2,key_3

# Image Generation Provider: 'local_sd' (FastSD CPU + Real-ESRGAN) or 'gemini'
DEFAULT_PROVIDER=local_sd

# Local SD (FastSD CPU) & Real-ESRGAN / Upscayl CLI Settings
FASTSD_URL=http://127.0.0.1:8000
UPSCAYL_BIN=./tools/upscayl/realesrgan-ncnn-vulkan.exe
FASTSD_STEPS=6
FASTSD_GUIDANCE=1.4
UPSCALE_ENABLED=true

# Gemini Models
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_FALLBACK_MODEL=gemini-2.5-flash-preview-tts

# Server & Storage Configuration (8001 avoids colliding with FastSD CPU on 8000)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001
FRONTEND_PORT=5173
PROJECTS_DIR=./projects
DB_PATH=./projects/storytube.db

# Rate Limit & Retry Tuning
GEMINI_MAX_RETRIES=5
GEMINI_REQUEST_DELAY_SEC=1.2
